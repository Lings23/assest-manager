JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-with-at-least-12-random-characters
JWT_TTL_HOURS=2

# Stage 2 IAM. Set IAM_PRIVATE_KEY_FILE in production; when omitted the
# development service generates an ephemeral RSA key at startup.
IAM_BOOTSTRAP_ADMIN_USERNAME=admin
IAM_BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-random-characters
IAM_COOKIE_SECURE=false
IAM_TOKEN_ISSUER=asset-platform-iam
IAM_TOKEN_AUDIENCE=asset-platform

POSTGRES_DB=asset_platform
POSTGRES_USER=asset
POSTGRES_PASSWORD=replace-with-a-long-random-secret
POSTGRES_PORT=5432
RABBITMQ_USER=asset
RABBITMQ_PASSWORD=replace-with-a-long-random-secret
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# Only publisher and worker receive an AMQP RABBITMQ_URL assembled by Compose.
# The management port is used by read-only smoke checks and operator tooling.
WORKER_SLOTS=2
WORKER_LEASE_DURATION=90s
WORKER_RENEW_INTERVAL=20s
WORKER_TASK_TIMEOUT=20m
# Broker ACK timeout is 30m in Compose and deploy/rabbitmq/rabbitmq.conf.
# If increasing WORKER_TASK_TIMEOUT, keep both ACK settings at least 1m longer.
WORKER_RECOVERY_INTERVAL=10s
WORKER_DRAIN_TIMEOUT=60s
# Enable only during a controlled legacy-message cutover; normal runtime is false.
WORKER_ALLOW_LEGACY_MESSAGES=false
INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters
MINIO_ROOT_USER=asset
MINIO_ROOT_PASSWORD=replace-with-a-long-random-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=asset-exports
S3_RETENTION_DAYS=7
GATEWAY_PORT=8080
WEB_PORT=8088
